# Sleeper — no API key needed, the read API is public. We only need your
# username so the agent can discover your league(s).
SLEEPER_USERNAME=your_sleeper_username
# Leave empty to use the current NFL season (recommended). Set only to work
# on a past season - a stale value here silently syncs last year's league.
SLEEPER_SEASON=
# Only needed to enact moves (lineup, IR, add/drop, waiver claims) and to see
# pending claims. Log in at sleeper.com, open DevTools > Application > Local
# Storage > https://sleeper.com, copy the value of `token`. It lasts about a
# year and gives FULL access to your account: treat it like a password.
SLEEPER_TOKEN=

# --- Used starting Stage 3+ (agent orchestrator) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# --- Used starting Stage 4 (email notifications) ---
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# --- Observability (LangSmith) ---
# Traces every ask/chat question: prompts, tool calls, results, tokens.
# Traces include league, fantasy team and manager names (not SLEEPER_TOKEN).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=fantasy-agent
